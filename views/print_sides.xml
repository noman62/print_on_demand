<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Sides Tree View-->
    <record id="print_sides_view_tree" model="ir.ui.view">
        <field name="name">print.sides.view.tree</field>
        <field name="model">print.sides</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <!--    Sides Menu Action-->
    <record id="action_print_sides" model="ir.actions.act_window">
        <field name="name">Sides</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.sides</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
